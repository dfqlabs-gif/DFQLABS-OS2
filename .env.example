# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database / Supabase (DFQLABS OS2 Project B)
SUPABASE_URL=https://your-os2-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Engine (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key

# JWT Authentication Secret
JWT_SECRET=dfqlabs-os2-jwt-secret-change-in-production

# Lead Finder discovery/enrichment
GOOGLE_PLACES_API_KEY=your-google-places-api-key
SERPER_API_KEY=your-serper-api-key

# Optional free-first Apify Nigeria Property Centre discovery (Apify Free plan has $5 monthly credits; no card required)
APIFY_API_TOKEN=your-apify-api-token
